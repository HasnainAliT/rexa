# EARAS / REXA - root environment variables
#
# This file configures `docker-compose.yml` (PostgreSQL + the FastAPI
# backend). Copy it to `.env` in the repo root and adjust as needed:
#
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS/Linux:           cp .env.example .env
#
# The frontend does NOT read this file - it uses its own `.env` (see the
# `VITE_API_BASE_URL` entry below, and the existing frontend .env.example).
# The backend, when run locally without Docker, uses `backend/.env` instead
# (see `backend/.env.example`).

# ---------------------------------------------------------------------
# PostgreSQL (db service)
# ---------------------------------------------------------------------
POSTGRES_USER=earas
POSTGRES_PASSWORD=earas
POSTGRES_DB=earas

# ---------------------------------------------------------------------
# Backend API (api service)
# ---------------------------------------------------------------------
# Built automatically from the POSTGRES_* vars above inside
# docker-compose.yml; override here only if you need a different value.
# DATABASE_URL=postgresql+psycopg2://earas:earas@db:5432/earas

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed CORS origins (Vite dev server + CRA-style default)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# REXA pipeline mode: "heuristic" (rule-based, default) or "trained"
MODEL_MODE=heuristic

PROJECT_NAME=EARAS / REXA API
API_PREFIX=/api

# ---------------------------------------------------------------------
# Frontend (Vite) - only used if you run `npm run dev` locally, or when
# building Dockerfile.frontend with --build-arg VITE_API_BASE_URL=...
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
