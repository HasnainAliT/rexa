# Database
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./earas.db
# Or PostgreSQL:
# DATABASE_URL=postgresql://earas:earas@localhost:5432/earas

# JWT / Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RExA model mode: "trained" (proposed Core RExA, default) or "heuristic" (fallback)
MODEL_MODE=trained
# Comparative DistilBERT star head (false = proposed Core RExA only)
USE_DISTILBERT_STARS=false

# App
PROJECT_NAME=RExA API
API_PREFIX=/api
